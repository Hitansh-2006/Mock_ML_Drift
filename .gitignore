*.log

# Retrain version reservations and dashboard-upload temp/backup files
models/.reserve_v*
data/.stream_upload_*.tmp
data/stream_data.bak.csv

# Generated model artifacts: only the v1 baseline is tracked (v2+ come from retraining)
models/*_v*.joblib
models/*_v*.meta.json
!models/*_v1.joblib
!models/*_v1.meta.json

# Local tooling
.venv/
node_modules/


# Old extracted copy (proj/): same rule as models/ - no generated v2+ artifacts, no install logs
proj/**/models/*_v[2-9]*
proj/**/models/*_v[1-9][0-9]*
proj/**/npm-ci.*

# Per-version drift reference snapshots (v1's is regenerated from data/training_data.csv on demand)
models/reference_*.parquet
