# Copy this file to .env. Docker Compose reads it, and so does the API when you
# start it locally (variables already set in your shell take priority).

# REQUIRED: the first dashboard account. The server creates this admin on startup if
# it doesn't exist yet. Pick your own password (8+ characters); there is no default,
# and obvious placeholders ("change-me", "password") are refused.
# More accounts later:  python -m serving.manage_users create <name> [--role viewer]
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: the login page's "Continue as guest" button (read-only). 1 = on, 0 = off.
GUEST_LOGIN_ENABLED=1

# Optional machine key, ONLY for the headless scripts (python -m automation.loop,
# python -m retrain.retrain_pipeline) that call the API without logging in.
# The dashboard never asks for it. Leave empty if you don't use those scripts.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Optional: browser origins allowed to call the API (comma-separated).
# Default covers the local dashboard: http://localhost:5173
# DASHBOARD_ORIGINS=http://localhost:5173

# Optional: default interval (seconds) of the dashboard's Automation loop, which
# runs inside the serving process. Start/stop it from the dashboard. Default 60.
# CHECK_INTERVAL_SECONDS=60
# Run ONE uvicorn worker only (model cache + scheduler live in the process).
# Headless alternative to the dashboard button: `docker compose --profile headless up`.

# Optional: how the dashboard judges the live error. The MAE is compared with what the
# current model scored on its own validation split: warn at 1.3x, alert at 2.0x by default.
# MAE_WARN_RATIO=1.3
# MAE_ALERT_RATIO=2.0
# Optional: how many requests after a model loads are treated as warm-up (not timed). Default 3.
# LATENCY_WARMUP_CALLS=3

# Optional: plain-English explanations via Groq. Without it the pipeline uses
# template-built explanations instead; nothing else changes.
GROQ_API_KEY=your_groq_api_key_here
