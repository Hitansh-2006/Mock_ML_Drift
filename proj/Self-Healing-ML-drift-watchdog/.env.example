# Copy this file to .env (docker compose reads it automatically).

# REQUIRED: protects every /admin/* endpoint (dashboard buttons, shadow deploy,
# promotion approval). Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The dashboard asks you for this key the first time you open it.
# Local dev without Docker: export the SAME value in every terminal that runs
# the API / automation loop / retrain (or set ADMIN_AUTH_DISABLED=1, dev only).
ADMIN_API_KEY=change-me

# Optional: browser origins allowed to call the API (comma-separated).
# Default covers the local dashboard: http://localhost:5173
# DASHBOARD_ORIGINS=http://localhost:5173

# Optional: plain-English explanations via Groq. Without it the pipeline uses
# template-built explanations instead; nothing else changes.
GROQ_API_KEY=your_groq_api_key_here
